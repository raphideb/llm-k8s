{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp-code": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LlamaCPP Coding",
      "options": {
        "baseURL": "http://172.22.22.57:30080/v1",
        "apiKey": "{env:LLAMACPP_CODE_KEY}"
      },
      "models": {
        "qwen2.5-coder-14b": {
          "name": "Qwen2.5-Coder-14B-Instruct",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "llamacpp-chat": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LlamaCPP Chat",
      "options": {
        "baseURL": "http://172.22.22.57:30081/v1",
        "apiKey": "{env:LLAMACPP_CHAT_KEY}"
      },
      "models": {
        "qwen2.5-14b": {
          "name": "Qwen2.5-14B-Instruct",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  }
}
